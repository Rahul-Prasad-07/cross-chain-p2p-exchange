# --- Solana RPC ---
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=                          # optional, typically same as RPC provider's WS
PROGRAM_ID=Swap1111111111111111111111111111111111111  # <-- put your Program ID

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dex_indexer

# --- Indexer behavior ---
# Max txs to fetch per page
BATCH_SIZE=1000
# Reconciliation interval (ms)
RECONCILE_EVERY_MS=30000
# Log level: debug|info|warn|error
LOG_LEVEL=info
